<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>دنیای ویدیو</title>

<meta name="description" content="دنیای ویدیو، تماشای ویدیو در فضای بی نهایت">

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #02020b;
    color: white;
    font-family: Tahoma, sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
}

/* ستاره ها */

#stars {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
}

.star {
    position: absolute;
    background: white;
    border-radius: 50%;
    animation: shine 2s infinite alternate;
}

@keyframes shine {
    from { opacity: .2; }
    to { opacity: 1; }
}

/* محتوای سایت */

main {
    position: relative;
    z-index: 1;
}

/* عنوان */

header {
    text-align: center;
    padding: 65px 15px 35px;
}

header h1 {
    font-size: clamp(28px, 5vw, 45px);
    text-shadow: 0 0 20px #008cff;
}

header p {
    color: #aaa;
    margin-top: 18px;
}

/* کارت ها */

.card {
    width: 90%;
    max-width: 850px;
    margin: 25px auto;
    padding: 25px;
    background: rgba(15, 15, 35, .95);
    border: 1px solid #244a91;
    border-radius: 18px;
    box-shadow: 0 0 25px #003b7b55;
}

.card h2 {
    text-align: center;
    color: #00c3ff;
    margin-bottom: 25px;
}

/* ویدیو */

video {
    display: block;
    width: 100%;
    max-height: 500px;
    background: black;
    border-radius: 12px;
}

input {
    width: 100%;
    padding: 14px;
    margin-top: 15px;
    background: #080818;
    border: 1px solid #444;
    border-radius: 9px;
    color: white;
    font-size: 14px;
}

button {
    width: 100%;
    padding: 14px;
    margin-top: 12px;
    background: linear-gradient(90deg, #006eff, #8300ff);
    border: none;
    border-radius: 9px;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    opacity: .8;
}

#status {
    text-align: center;
    color: #aaa;
    margin-top: 15px;
    font-size: 13px;
}

/* سازندگان */

.credit {
    padding: 17px;
    margin: 12px 0;
    background: #ffffff0a;
    border-right: 3px solid #008cff;
    border-radius: 9px;
    transition: .3s;
}

.credit:hover {
    background: #008cff22;
    transform: translateX(-5px);
}

/* فوتر */

footer {
    text-align: center;
    padding: 30px;
    color: #777;
    font-size: 13px;
}

</style>
</head>

<body>

<div id="stars"></div>

<main>

<header>
    <h1>🌌 دنیای ویدیو 🌌</h1>
    <p>به دنیای بی نهایت خوش آمدید</p>
</header>

<!-- بخش پخش ویدیو -->

<section class="card">

    <h2>🎬 تماشای ویدیو</h2>

    <video
        id="player"
        controls
        playsinline
        preload="metadata">
    </video>

    <input
        type="url"
        id="videoLink"
        placeholder="لینک مستقیم ویدیو را وارد کنید..."
    >

    <button id="playButton">
        پخش ویدیو
    </button>

    <input
        type="file"
        id="videoFile"
        accept="video/*"
    >

    <p id="status">
        لینک مستقیم MP4 یا فایل ویدیویی انتخاب کنید.
    </p>

</section>

<!-- بخش سازندگان -->

<section class="card">

    <h2>⭐ سازندگان سایت ⭐</h2>

    <div class="credit">
        👨‍💻 سازنده سایت : معین باقری
    </div>

    <div class="credit">
        🎨 طراح ویدیو : متین باقری
    </div>

    <div class="credit">
        💻 سازنده سایت : متین باقری
    </div>

    <div class="credit">
        🎧 صدابرداری : متین باقری
    </div>

</section>

<footer>
    ساخته شده با ❤️
</footer>

</main>

<script>

/* ساخت ستاره ها */

const starContainer = document.getElementById("stars");

for (let i = 0; i < 180; i++) {

    const star = document.createElement("span");

    star.className = "star";

    const size = Math.random() * 3 + 1;

    star.style.width = size + "px";
    star.style.height = size + "px";

    star.style.left = Math.random() * 100 + "%";
    star.style.top = Math.random() * 100 + "%";

    star.style.animationDuration =
        (Math.random() * 3 + 1) + "s";

    star.style.animationDelay =
        Math.random() * 3 + "s";

    starContainer.appendChild(star);
}


/* انتخاب عناصر */

const player = document.getElementById("player");
const linkInput = document.getElementById("videoLink");
const fileInput = document.getElementById("videoFile");
const statusText = document.getElementById("status");

let currentObjectURL = null;


/* پخش لینک */

document.getElementById("playButton").addEventListener("click", function() {

    const url = linkInput.value.trim();

    if (!url) {
        statusText.textContent = "لطفاً لینک ویدیو را وارد کنید.";
        return;
    }

    try {

        const parsed = new URL(url);

        if (parsed.protocol !== "https:" && parsed.protocol !== "http:") {
            throw new Error("Invalid URL");
        }

        player.pause();
        player.src = parsed.href;
        player.load();

        statusText.textContent =
            "ویدیو بارگذاری شد. برای پخش دکمه Play را بزنید.";

    } catch (error) {

        statusText.textContent = "لینک وارد شده معتبر نیست.";

    }

});


/* انتخاب ویدیو از دستگاه */

fileInput.addEventListener("change", function() {

    const file = fileInput.files[0];

    if (!file) return;

    if (!file.type.startsWith("video/")) {
        statusText.textContent = "فایل انتخاب شده ویدیو نیست.";
        return;
    }

    if (currentObjectURL) {
        URL.revokeObjectURL(currentObjectURL);
    }

    currentObjectURL = URL.createObjectURL(file);

    player.pause();
    player.src = currentObjectURL;
    player.load();

    statusText.textContent =
        "ویدیو انتخاب شد. برای پخش دکمه Play را بزنید.";

});


/* خطای پخش */

player.addEventListener("error", function() {

    statusText.textContent =
        "ویدیو پخش نشد. لینک مستقیم یا فرمت فایل را بررسی کنید.";

});

</script>

</body>
</html>
